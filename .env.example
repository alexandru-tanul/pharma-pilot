# Docker Compose Configuration
# Use docker-compose.local.yml for development or docker-compose.production.yml for production
COMPOSE_FILE=docker-compose.local.yml

# FastAPI Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# LLM API Keys (set the one matching your MODEL choice)
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# LLM Model Configuration (litellm)
# See litellm docs for full list: https://docs.litellm.ai/docs/providers
# Options: claude-sonnet-4-5, claude-haiku-4-5, gemini/gemini-3-flash-preview, gemini/gemini-2.0-flash-exp
MODEL=gemini/gemini-3-flash-preview

# PostgreSQL Database (app_data - chat history)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=app_data
POSTGRES_PASSWORD=your-secure-password-here
